#!/usr/bin/env bash
set -euo pipefail

cwd=""
thread_id=""
endpoint=""
session=""
detached=0
model=""
reasoning="max"
fast=0
codex_bin="${CODEX_COMMAND:-codex}"

usage() {
  printf '%s\n' 'Usage: tmux-codex --cwd DIR --thread-id ID --endpoint WS_URL --session NAME [--detached]'
}

while (($#)); do
  case "$1" in
    --cwd) cwd="${2:?missing value for --cwd}"; shift 2 ;;
    --thread-id) thread_id="${2:?missing value for --thread-id}"; shift 2 ;;
    --endpoint) endpoint="${2:?missing value for --endpoint}"; shift 2 ;;
    --session) session="${2:?missing value for --session}"; shift 2 ;;
    --detached) detached=1; shift ;;
    --model) model="${2:?missing value for --model}"; shift 2 ;;
    --reasoning|--effort) reasoning="${2:?missing value for --reasoning}"; shift 2 ;;
    --fast) fast=1; shift ;;
    --no-fast) fast=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$cwd" && -n "$thread_id" && -n "$endpoint" && -n "$session" ]] || { usage >&2; exit 2; }
[[ -d "$cwd" ]] || { printf 'cwd does not exist: %s\n' "$cwd" >&2; exit 1; }

if tmux has-session -t "$session" 2>/dev/null; then
  if ((detached)); then exit 0; fi
  exec tmux attach-session -t "$session"
fi

if ! (curl -fsS --max-time 1 "${endpoint/ws/http}/readyz" >/dev/null 2>&1); then
  "$codex_bin" app-server \
    --listen "$endpoint" \
    -c 'approval_policy="never"' \
    -c 'sandbox_mode="danger-full-access"' \
    -c 'service_tier=null' \
    >"${WECHATBOT_CODEX_LOG:-/tmp/wecode-codex-app-server.log}" 2>&1 &
  server_pid=$!
  for _ in {1..150}; do
    curl -fsS --max-time 1 "${endpoint/ws/http}/readyz" >/dev/null 2>&1 && break
    kill -0 "$server_pid" 2>/dev/null || break
    sleep 0.1
  done
fi

codex_args=(resume "$thread_id" --remote "$endpoint" -C "$cwd" --dangerously-bypass-approvals-and-sandbox --no-alt-screen)
[[ -n "$model" ]] && codex_args+=(--model "$model")
[[ -n "$reasoning" ]] && codex_args+=(-c "model_reasoning_effort=\"$reasoning\"")
if [[ "$fast" == 1 ]]; then
  codex_args+=(-c 'service_tier="fast"')
elif [[ "$fast" == 0 ]]; then
  codex_args+=(-c 'service_tier=null')
fi
tmux new-session -d -s "$session" -- "$codex_bin" "${codex_args[@]}"

if ((detached)); then exit 0; fi
exec tmux attach-session -t "$session"
