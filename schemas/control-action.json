{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "cwd", "limit", "text"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "new_session",
        "list_sessions",
        "reply",
        "ask"
      ]
    },
    "cwd": { "type": ["string", "null"] },
    "limit": { "type": ["integer", "null"], "minimum": 1 },
    "text": { "type": ["string", "null"] }
  }
}
