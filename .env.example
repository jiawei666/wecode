# wecode 默认可直接运行；首次扫码登录后，下面两项也可以都留空。

# 长期运行或共享机器建议填写，只允许这个微信用户使用。
WECHATBOT_ALLOWED_USER=

# 可选：新会话默认目录；留空则使用仓库目录。
WECHATBOT_DEFAULT_CWD=

# 只有需要自定义时才打开下面的配置：
# WECHATBOT_SEARCH_ROOTS=/path/to/projects,/another/root
# CODEX_MODEL=你的可用模型名
# CODEX_COMMAND=codex
# CODEX_APP_ENDPOINT=ws://127.0.0.1:45037
# SHARE_PAGE_BASE_URL=https://你的分享页域名

# 其他超时、分页、iLink 地址和分享页参数均有稳定默认值，
# 一般不需要写入 .env；需要覆盖时请参阅 README 的“高级配置”。
