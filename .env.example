# Optional. The first `npm run dev -- login` stores WeChat credentials in WECHATBOT_DATA_DIR.
WECHATBOT_DATA_DIR=.data

# Leave empty to use the account bound by QR login.
WECHATBOT_ALLOWED_USER=

# The control Agent has full access. Configure these for your own machine.
# Empty WECHATBOT_SEARCH_ROOTS defaults to this project directory.
WECHATBOT_HOME=
WECHATBOT_SEARCH_ROOTS=
WECHATBOT_DEFAULT_CWD=

CODEX_COMMAND=codex
# Model and reasoning settings are environment-specific; keep the defaults or override them here.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
CODEX_FAST=false
CONTROL_MODEL=gpt-5.6-luna
CONTROL_REASONING_EFFORT=max
CODEX_APP_ENDPOINT=ws://127.0.0.1:45037

# Runtime cleanup. Idle bindings are unsubscribed from the App Server; Codex history is preserved.
WECHATBOT_IDLE_TIMEOUT_MS=7200000
WECHATBOT_CONTROL_TIMEOUT_MS=1800000
WECHATBOT_SELECTION_TIMEOUT_MS=600000
WECHATBOT_BINDING_HISTORY_LIMIT=5
WECHATBOT_SESSION_LIST_LIMIT=5

# Set to a local cloudflared binary if it is not on PATH.
CLOUDFLARED_COMMAND=cloudflared
# Optional public base URL if you provide your own reverse proxy/tunnel to the local page server.
SHARE_PAGE_BASE_URL=
WECHATBOT_PAGE_TTL_MS=86400000

# Optional protocol/runtime overrides.
ILINK_API_BASE=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_CHANNEL_VERSION=wechatbot/0.1
WECHATBOT_CHAT_CHUNK_SIZE=1200
WECHATBOT_POLL_TIMEOUT_MS=35000
